# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=customer_portal
DB_USER=root
DB_PASSWORD=CHANGE_ME

# Server
PORT=4000
NODE_ENV=development

# CORS: Frontend origin (Vite dev default)
CORS_ORIGIN=http://localhost:5173

# Code Generation
# VARCHAR(4) for Global/Handling codes. Do NOT increase without schema change.
CODE_MAX_LENGTH=4
CODE_MAX_RETRIES=50

# File Upload Directory (relative to backend/)
UPLOAD_DIR=uploads
