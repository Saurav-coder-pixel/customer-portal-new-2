# Oracle Database Connection
# FOIS migration-friendly: swap these values when moving from TEST to FOIS PROD
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=ORCL
DB_USERNAME=FOIS_TEST_USER
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Connection Pool Settings
DB_POOL_MIN=4
DB_POOL_MAX=20
DB_POOL_INCREMENT=2

# Server
PORT=4000
NODE_ENV=development

# CORS: Frontend origin (Vite dev default)
CORS_ORIGIN=http://localhost:5173

# Code Generation
# FOIS currently uses VARCHAR2(4) for Global/Handling codes.
# DO NOT increase this unless FOIS team officially expands the column length.
CODE_MAX_LENGTH=4
CODE_MAX_RETRIES=50
